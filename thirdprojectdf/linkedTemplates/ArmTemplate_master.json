{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "thirdprojectdf"
		},
		"AzureSqlDatabase_linked_service_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureSqlDatabase_linked_service'"
		},
		"DataLakeStorage_linked_service_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'DataLakeStorage_linked_service'"
		},
		"AzureSqlDatabase_linked_service_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "serverthirdprojectssql.database.windows.net"
		},
		"AzureSqlDatabase_linked_service_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "thirdprojectsql"
		},
		"AzureSqlDatabase_linked_service_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "adminadmin"
		},
		"DataLakeStorage_linked_service_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://thirdprojectstorage.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "thirdprojectdf_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureSqlDatabase_linked_service_password": {
						"value": "[parameters('AzureSqlDatabase_linked_service_password')]"
					},
					"DataLakeStorage_linked_service_accountKey": {
						"value": "[parameters('DataLakeStorage_linked_service_accountKey')]"
					},
					"AzureSqlDatabase_linked_service_properties_typeProperties_server": {
						"value": "[parameters('AzureSqlDatabase_linked_service_properties_typeProperties_server')]"
					},
					"AzureSqlDatabase_linked_service_properties_typeProperties_database": {
						"value": "[parameters('AzureSqlDatabase_linked_service_properties_typeProperties_database')]"
					},
					"AzureSqlDatabase_linked_service_properties_typeProperties_userName": {
						"value": "[parameters('AzureSqlDatabase_linked_service_properties_typeProperties_userName')]"
					},
					"DataLakeStorage_linked_service_properties_typeProperties_url": {
						"value": "[parameters('DataLakeStorage_linked_service_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}